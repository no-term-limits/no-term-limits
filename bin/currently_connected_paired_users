#!/usr/bin/env bash

function error_handler() {
  >&2 echo "Exited with BAD EXIT CODE '${2}' in ${0} script at line: ${1}."
  exit "$2"
}
trap 'error_handler ${LINENO} $?' ERR
set -Eeuo pipefail

# HELP: shows pair users currently connected over SSH to wemux or Zellij (see start_pairing)

pair_users_file="${NO_TERM_LIMITS_PAIR_USERS_FILE:-/var/tmp/no_term_limits_wemux_ssh_users}"

function active_remote_pair_users_from_logind() {
  local session_id
  local session_properties
  local session_user

  while read -r session_id _; do
    [[ -n "$session_id" ]] || continue
    session_properties="$(loginctl show-session "$session_id" \
      --property=Name --property=Remote --property=State 2>/dev/null || true)"

    if ! grep -qx 'Remote=yes' <<<"$session_properties" ||
      ! grep -qx 'State=active' <<<"$session_properties"; then
      continue
    fi

    session_user="$(awk -F= '$1 == "Name" { print $2 }' <<<"$session_properties")"
    if [[ -n "$session_user" ]] && grep -Fxq "$session_user" "$pair_users_file"; then
      echo "$session_user"
    fi
  done < <(loginctl list-sessions --no-legend --no-pager 2>/dev/null || true)
}

if [[ -n "${TMUX:-}" ]] && command -v wemux >/dev/null; then
  # get STDERR so we can filter out the message we don't care about: no server running on /tmp/wemux-wemux
  wemux_users_output="$(wemux users 2>&1)"
  wemux_users_output="$(grep -v 'no server running' <<<"$wemux_users_output" || echo '')"

  if [[ -n "$wemux_users_output" ]]; then
    (grep -vE '(error connecting|connected.*:)' <<<"$wemux_users_output" || echo '') | perl -p -e 's/^ +\d+\. (.*)/\1/' | hot_sed -E "/\<$(whoami)\>/d" | sort | uniq
  fi
elif [[ -n "${ZELLIJ:-}" ]]; then
  if command -v loginctl >/dev/null && [[ -r "$pair_users_file" ]]; then
    active_remote_pair_users_from_logind | sort -u | paste -sd ' ' -
  else
    # macOS and systems without systemd-logind still use the legacy utmp
    # database exposed by users(1).
    users | tr " " "\n" | sort -u | (grep -vE '^(root)$' || true) | paste -sd ' ' -
  fi
fi
