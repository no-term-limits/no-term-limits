#!/usr/bin/env bash

function error_handler() {
  >&2 echo "Exited with BAD EXIT CODE '${2}' in ${0} script at line: ${1}."
  exit "$2"
}
trap 'error_handler ${LINENO} $?' ERR
set -o errtrace -o errexit -o nounset -o pipefail

# HELP: git: popular: checks for remote commits, then runs git add, git commit, and gpush. see also gcu and gcd.
# If paired users are connected through wemux it will add them to the commit
# message as collaborators as well.
#
# Behavior controls:
# - NO_TERM_LIMITS_RUN_GIT_ADD: controls what to add before commit
#     all      (default) - git add .
#     updated             - git add -u
#     patch               - add untracked, then git add -p
# - GC_NO_VERIFY: if set to a non-empty value, runs git commit with --no-verify

commit_message="$*"

if [[ -z "${NO_TERM_LIMITS_RUN_GIT_ADD:-}" ]]; then
  NO_TERM_LIMITS_RUN_GIT_ADD=all
fi

if [[ -z "$commit_message" ]]; then
  echo "ERROR: please supply commit message as first argument"
  exit 1
fi

# Check the same remote and branch that gpush will use, even without an upstream.
push_remote="$(git_remote "$(git config --get remote.pushDefault || true)" 2>/dev/null)"
branchname=$(git_branch)
if git ls-remote --exit-code --heads "$push_remote" "refs/heads/$branchname" >/dev/null; then
  git fetch --no-tags "$push_remote" "refs/heads/$branchname"
  behind_count=$(git rev-list --count HEAD..FETCH_HEAD)
  if [[ "$behind_count" -gt 0 ]]; then
    echo >&2 "ERROR: $branchname is behind $push_remote/$branchname by $behind_count commit(s). Pull/rebase before committing."
    exit 1
  fi
else
  remote_status=$?
  # ls-remote returns 2 when the branch does not exist yet; new branches are OK.
  if [[ "$remote_status" -ne 2 ]]; then
    echo >&2 "ERROR: Could not check $push_remote/$branchname; refusing to commit."
    exit "$remote_status"
  fi
fi

if command -v gc_pre_commit_check >/dev/null; then
  gc_pre_commit_check
fi

if [[ "${NO_TERM_LIMITS_GC_ADD_PAIRED_USERS:-}" != "false" ]]; then
  currently_connected_paired_users=""
  if command -v get_pair_users_for_git_commit_message >/dev/null; then
    currently_connected_paired_users=$(get_pair_users_for_git_commit_message)
  else
    currently_connected_paired_users=$(currently_connected_paired_users | (hot_sed -E "s/\<$(whoami)\>//" | perl -p -e 's/ *$//' || echo ''))
  fi

  if [[ -n "$currently_connected_paired_users" ]]; then
    commit_message="$commit_message w/ $currently_connected_paired_users"
  fi
fi

sleep_period=1

echo "about to commit with commit message: $commit_message"
echo "ctrl+c in next ${sleep_period} seconds to abort git commit"
sleep "$sleep_period"

if [[ "$NO_TERM_LIMITS_RUN_GIT_ADD" == "all" ]]; then
  git add .
elif [[ "$NO_TERM_LIMITS_RUN_GIT_ADD" == "updated" ]]; then
  git add -u
elif [[ "$NO_TERM_LIMITS_RUN_GIT_ADD" == "patch" ]]; then
  # always add all untracked files, but let the -p deal with updated files
  git ls-files --others --exclude-standard | xargs git add
  git add -p
fi

if [[ "${GC_NO_VERIFY:-}" == "true" ]]; then
  git commit --no-verify -m "$commit_message"
else
  git commit -m "$commit_message"
fi

echo "committed. ctrl+c in next ${sleep_period} seconds to abort gpush"
sleep "$sleep_period"

gpush
