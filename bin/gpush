#!/usr/bin/env bash

function error_handler() {
  echo >&2 "Exited with BAD EXIT CODE '${2}' in ${0} script at line: ${1}."
  exit "$2"
}
trap 'error_handler ${LINENO} $?' ERR
set -o errtrace -o errexit -o nounset -o pipefail

# HELP: git: popular: shortcut for "git push" using remote.pushDefault, then the upstream remote or origin

git_remote="$(git_remote "$(git config --get remote.pushDefault || true)")"
branchname=$(git_branch)
echo "git push $git_remote $branchname"
git push $git_remote $branchname $@
