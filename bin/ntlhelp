#!/usr/bin/env zsh

# HELP: finds and prints command and can take a regex search pattern. type "ntlhelp" with no arguments for more info

set -e

if ! command -v rg >/dev/null 2>&1; then
  >&2 echo "ERROR: ntlhelp requires ripgrep (rg)"
  exit 1
fi

pattern="$1"
extra_patterns=$(perl -p -e "s/ /\n/g" <<<${@:2})

function print_usage() {
  echo 'usage: ntlhelp (optional)[regex_search_pattern1] [regex_search_pattern2] [...]'
  echo
  echo -e '\tregex_search_patterns:\tgets passed directly into rg to search and into perl for coloring'
  echo -e '\t\tThis means a pattern to search for the edit file with pattern shortcut like "\<ef\>" will rg properly but found items will not be red'
  echo -e '\t\tHowever "\\bef\\b" will work with both rg and with perl for coloring'
  echo -e '\tuse NO_TERM_LIMITS_DO_NOT_PRINT_HELP_MESSAGE=true to not print the help messages and only print the commands'
  echo -e '\trun cac with any command to print out its full definition'
}

if help_option_passed_in_command_arg "$@"; then
  print_usage
  exit 0
fi

if [[ -z "$pattern" ]]; then
  print_usage
  echo
fi

# Cache colors: each print_color call spawns a shell, and highlighting runs per match.
NTL_RED="$(print_color red)"
NTL_GREEN="$(print_color green)"
NTL_END="$(print_color end)"

function rg_and_highlight() {
  local_pattern="$1"
  shift
  if [[ -n "$local_pattern" ]]; then
    rg -e "$local_pattern" <<<"$@" | perl -p -e "s/(${local_pattern})/${NTL_RED}\1${NTL_END}/g"
  else
    echo "$@"
  fi
}

function process_file() {
  file="$1"

  # avoid empty strings
  if [[ -f "$file" ]]; then
    command_name="${file##*/}"
    help_messages=''
    if [[ "$NO_TERM_LIMITS_DO_NOT_PRINT_HELP_MESSAGE" != "true" ]]; then
      help_messages=$(rg -e '^# HELP' -- "$file" || echo '')
    fi

    is_source_file='false'
    # Multiple HELP lines means a sourced file defining multiple commands (e.g. .zshrc).
    if [[ "$help_messages" == *$'\n'* ]]; then
      is_source_file='true'
    fi

    results=''
    while read -r help_message; do
      result=''

      if [[ -n "$help_message" ]]; then
        if [[ "${is_source_file}" == 'true' ]]; then
          command_name=$(perl -p -e 's/# HELP ((\w|-)*):.*/\1/g' <<<"$help_message")
          help_message=$(perl -p -e 's/# HELP (\w|-)*: (.*)/\2/g' <<<"$help_message")
        fi
        # Strip "# HELP" prefix without forking perl (same as s/^# HELP:? ?//).
        stripped_help_message="${help_message#\# HELP}"
        stripped_help_message="${stripped_help_message#:}"
        stripped_help_message="${stripped_help_message# }"
        result=$(rg_and_highlight "$pattern" "${command_name} ---> ${stripped_help_message}")
      else
        result=$(rg_and_highlight "$pattern" "$command_name")
      fi

      while read -r extra_pattern; do
        if [[ -n "$extra_pattern" ]]; then
          result=$(rg_and_highlight "$extra_pattern" "$result")
        fi
      done <<<"${extra_patterns}"

      if [[ -n "$result" ]]; then
        results="${results}\n**${result}"
      fi
    done <<<"${help_messages}"

    if [[ -n "$results" ]]; then
      echo -n "${results}"
    fi
  fi

}

function get_help_from_bin_dirs() {
  for bin_dir in $(bin_dirs_in_home); do
    # Skip missing dirs: with set -e a failed find would abort the whole loop.
    [[ -d "$bin_dir" ]] || continue
    all_files=$(find "$bin_dir" -type f 2>/dev/null || true)
    if [[ -n "$pattern" ]]; then
      files_that_match=$(rg -e "$pattern" <<<"$all_files" || echo '')
      help_messages_that_match=$(rg -l --no-messages -e "^# ?HELP:.*${pattern}" "$bin_dir" 2>/dev/null || echo '')
      files_to_process=$(echo "$files_that_match\n$help_messages_that_match" | sort | uniq)
      # Pre-filter candidates on extra patterns too: a match must contain every pattern.
      while read -r extra_pattern; do
        if [[ -n "$extra_pattern" ]]; then
          extra_files_that_match=$(rg -e "$extra_pattern" <<<"$all_files" || echo '')
          extra_help_that_match=$(rg -l --no-messages -e "^# ?HELP:.*${extra_pattern}" "$bin_dir" 2>/dev/null || echo '')
          extra_files=$(echo "$extra_files_that_match\n$extra_help_that_match" | sort | uniq)
          files_to_process=$(echo "${files_to_process}\n${extra_files}" | sort | uniq -d || true)
        fi
      done <<<"${extra_patterns}"
    else
      files_to_process="$all_files"
    fi

    # Single command substitution for the whole loop instead of one per file.
    full_output_message=$(while read -r file; do process_file "$file"; done <<<"$files_to_process")

    if [[ -n "$full_output_message" ]]; then
      echo -e "\n${NTL_GREEN}Commands in ${bin_dir}:${NTL_END}"
      echo -e "${full_output_message}"
    fi
  done
}

function get_help_from_sourced_files() {
  results_from_common="$(process_file "${HOME}/.zshrc")"
  if [[ -n "$results_from_common" ]]; then
    results_from_common=$(echo -e "\n\n${NTL_GREEN}Commands in ${HOME}/.zshrc:${NTL_END}\n${results_from_common}")
  fi
  echo "$results_from_common"
}

if [[ -z "$pattern" ]]; then
  dohelp "${HOME}/.zshrc"
  if [[ -f "${HOME}/.zshrc.no_term_limits_overrides" ]]; then
    dohelp "${HOME}/.zshrc.no_term_limits_overrides"
  fi
  pattern=metahelpcommands
  get_help_from_bin_dirs
  pattern=''
fi

if [[ -n "$pattern" ]]; then
  output="$(get_help_from_bin_dirs)$(get_help_from_sourced_files)"
  format_command_help_messages "$output"
fi
